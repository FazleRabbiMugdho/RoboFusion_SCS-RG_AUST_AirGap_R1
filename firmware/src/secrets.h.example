#ifndef SECRETS_H
#define SECRETS_H

// WiFi credentials — fill in your network's SSID and password.
// Copy this file to secrets.h (gitignored) and replace the placeholders.
#define WIFI_SSID     "your_wifi_ssid"
#define WIFI_PASSWORD "your_wifi_password"

// Per-zone API key — must match the key provisioned in the backend
// for this zone (used by both ingestion POST and command endpoint auth).
#define ZONE_API_KEY  "your_zone_api_key"

#endif  // SECRETS_H
